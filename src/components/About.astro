---
import { getEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = (await getEntry('site', 'main'))!.data;
---
<section id="about" class="section" data-reveal>
  <h2 class="section-title">{t(lang, 'section.about')}</h2>
  <div class="about-grid">
    <img class="photo" src={site.profileImage} alt={site.name[lang]} loading="lazy" data-reveal />
    <div class="intro">
      <p class="slogan" data-slogan-repel data-reveal style="transition-delay: 0.12s">
        {site.slogan.map((line) => <span>{line}</span>)}
      </p>
      <p class="bio" data-reveal style="transition-delay: 0.24s">{site.about[lang]}</p>
      <div class="actions" data-reveal style="transition-delay: 0.36s">
        <a class="btn" href={site.github} target="_blank" rel="noopener">
          {t(lang, 'about.github')}
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></svg>
          </span>
        </a>
        <a class="btn" href="#projects">
          {t(lang, 'about.projects')}
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
<style>
  .about-grid { display: grid; grid-template-columns: 300px 1fr; gap: 48px; align-items: center; }
  .photo { width: 100%; border-radius: 12px; box-shadow: var(--shadow); }
  .slogan { display: flex; flex-direction: column; font-size: 1.6rem; font-weight: 700; margin-bottom: 20px; }
  .slogan :global(.ch) { display: inline-block; transition: transform 0.18s ease-out; will-change: transform; }
  @media (prefers-reduced-motion: reduce) { .slogan :global(.ch) { transition: none; } }
  .bio { color: var(--muted); white-space: pre-line; margin-bottom: 28px; }
  .actions { display: flex; gap: 12px; }
  .actions { align-items: center; }
  .btn { display: inline-flex; align-items: center; padding: 10px 24px; border-radius: 8px;
    text-decoration: none; background: var(--card); border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease-out, border-color 0.15s, padding 0.25s ease; }
  .btn:hover { border-color: var(--accent); padding-top: 14px; padding-bottom: 14px; }
  /* hover 시 오른쪽·위아래로 넓어지며 직접 그린 화살표 등장 (옆 버튼이 자연스럽게 밀려남) */
  .btn .arrow { display: inline-flex; align-items: center; max-width: 0; opacity: 0; overflow: hidden;
    margin-left: 0; transform: translateX(-6px);
    transition: max-width 0.25s ease, opacity 0.2s ease, margin-left 0.25s ease, transform 0.25s ease; }
  .btn .arrow svg { width: 1.1em; height: 1.1em; flex-shrink: 0; }
  .btn:hover .arrow { max-width: 1.4em; opacity: 1; margin-left: 10px; transform: none; }
  @media (prefers-reduced-motion: reduce) { .btn .arrow { transition: none; } }
  @media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; } .photo { max-width: 260px; margin: 0 auto; } }
</style>
<script>
  import { initMagnetic } from '../scripts/magnetic';
  import { splitAndRepel } from '../scripts/charRepel';
  initMagnetic([...document.querySelectorAll<HTMLElement>('#about .actions .btn')]);
  document.querySelectorAll<HTMLElement>('[data-slogan-repel] > span').forEach((el) => splitAndRepel(el));
</script>
