---
import { getCollection, getEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = (await getEntry('site', 'main'))!.data;
const featured = (await getCollection('projects', (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const title = 'Portfolio';
---
<section class="hero" data-reveal>
  <h1 class="hero-title" aria-label={title} data-char-repel>
    {[...title].map((ch) => (
      <span class="ch" aria-hidden="true">{ch === ' ' ? ' ' : ch}</span>
    ))}
  </h1>
  {featured.length > 0 && (
    <div class="hero-ring" data-ring>
      <div class="ring-stage">
        {featured.map((p) => (
          <button class="ring-card" data-slug={p.id} aria-label={p.data.title[lang]}>
            <img src={p.data.thumbnail} alt={p.data.title[lang]} draggable="false" loading="eager" />
          </button>
        ))}
      </div>
    </div>
  )}
  <p class="hero-name" aria-label={site.name.en} data-char-repel>
    {[...site.name.en].map((ch) => (
      <span class="ch" aria-hidden="true">{ch === ' ' ? ' ' : ch}</span>
    ))}
  </p>
  <p class="dev-name">Dev name_ {site.devName}</p>
</section>
<style>
  .hero { min-height: 100svh; display: flex; flex-direction: column; align-items: center;
    justify-content: flex-start; text-align: center; overflow: hidden; padding: 28px 24px 24px; }
  .hero-ring { perspective: 1200px; width: 100%; height: 340px; touch-action: pan-y;
    cursor: grab; user-select: none; }
  .hero-ring.dragging { cursor: grabbing; }
  .ring-stage { position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d; transform: rotateY(var(--ring-angle, 0deg)); }
  .ring-card { position: absolute; left: 50%; top: 50%; width: 180px; height: 240px;
    margin: -120px 0 0 -90px; border: none; padding: 0; border-radius: 12px; overflow: hidden;
    background: var(--card); box-shadow: var(--shadow); backface-visibility: hidden; }
  .ring-card img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

  /* 링 카드 개별 등장: 히어로 리빌 후 하나씩 스르륵 (opacity + 이미지 슬라이드) */
  .hero:not(.revealed) .ring-card { opacity: 0; }
  .hero.revealed .ring-card { opacity: 1; transition: opacity 0.7s ease; }
  .hero:not(.revealed) .ring-card img { transform: translateY(24px); }
  .hero.revealed .ring-card img { transform: none; transition: transform 0.7s ease; }
  /* 등장 순서: 마지막 장(첫 장 왼쪽) → 첫 장 → 두 번째 장 → … → 마지막 전 장 */
  .hero.revealed .ring-card:nth-child(1), .hero.revealed .ring-card:nth-child(1) img { transition-delay: 0.18s; }
  .hero.revealed .ring-card:nth-child(2), .hero.revealed .ring-card:nth-child(2) img { transition-delay: 0.36s; }
  .hero.revealed .ring-card:nth-child(3), .hero.revealed .ring-card:nth-child(3) img { transition-delay: 0.54s; }
  .hero.revealed .ring-card:nth-child(4), .hero.revealed .ring-card:nth-child(4) img { transition-delay: 0.72s; }
  .hero.revealed .ring-card:nth-child(n+5), .hero.revealed .ring-card:nth-child(n+5) img { transition-delay: 0.9s; }
  .hero.revealed .ring-card:last-child, .hero.revealed .ring-card:last-child img { transition-delay: 0s; }

  h1 { font-size: clamp(4rem, 11vw, 7rem); font-weight: 800; letter-spacing: -0.02em;
    margin: 0 0 20px; }
  .hero-name { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; margin-top: 8px; letter-spacing: -0.01em; }
  .hero-title .ch, .hero-name .ch { display: inline-block; transition: transform 0.18s ease-out; will-change: transform; }
  @media (prefers-reduced-motion: reduce) {
    .hero .ring-card, .hero .ring-card img { opacity: 1; transform: none; transition: none; }
    .hero-title .ch, .hero-name .ch { transition: none; }
  }
  .dev-name { color: var(--muted); margin-bottom: auto; }
  @media (max-width: 640px) { .ring-card { width: 130px; height: 180px; margin: -90px 0 0 -65px; } }
</style>
<script>
  import { initHeroRing } from '../scripts/heroRing';
  import { initCharRepel } from '../scripts/charRepel';
  const root = document.querySelector<HTMLElement>('[data-ring]');
  if (root) initHeroRing(root);
  document.querySelectorAll<HTMLElement>('[data-char-repel]').forEach(initCharRepel);
</script>
