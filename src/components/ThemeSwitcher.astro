---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const themes = [
  { name: 'light', color: '#fafafa' },
  { name: 'cream', color: '#f7f2e7' },
  { name: 'sky', color: '#eef4fa' },
  { name: 'violet', color: '#f4effa' },
  { name: 'grape', color: '#2a1b3d' },
  { name: 'dark', color: '#111214' },
  { name: 'forest', color: '#0f1a14' },
];
---
<div class="theme-switcher" data-theme-switcher>
  <div class="dots" role="group" aria-label={t(lang, 'theme.label')}>
    {themes.map((th) => (
      <button class="dot" data-theme-choice={th.name} style={`--dot: ${th.color}`}
        tabindex="-1" aria-label={`${t(lang, 'theme.label')}: ${th.name}`} />
    ))}
  </div>
  <button class="palette-btn" data-palette-toggle aria-expanded="false"
    aria-label={t(lang, 'theme.label')}>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
      stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3a9 9 0 1 0 0 18h1.5a2.5 2.5 0 0 0 0-5H12a2 2 0 0 1 0-4h6.5A2.5 2.5 0 0 0 21 9.5 8.5 8.5 0 0 0 12 3Z" />
      <circle cx="7.5" cy="11.5" r="1" fill="currentColor" stroke="none" />
      <circle cx="10" cy="7.5" r="1" fill="currentColor" stroke="none" />
      <circle cx="14.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  </button>
</div>
<style>
  .theme-switcher { position: fixed; right: 24px; bottom: 24px; z-index: 60;
    width: 48px; height: 48px; }
  .palette-btn { position: relative; z-index: 1; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--card); color: var(--text); border: 1px solid var(--border);
    box-shadow: var(--shadow); transition: transform 0.15s; }
  .palette-btn:hover { transform: scale(1.08) rotate(-10deg); }
  .dots { position: absolute; inset: 0; pointer-events: none; }
  .dot { position: absolute; left: 50%; top: 50%; width: 26px; height: 26px;
    margin: -13px 0 0 -13px; border-radius: 50%; border: 2px solid var(--border);
    background: var(--dot); box-shadow: var(--shadow);
    opacity: 0; transform: translate(0, 0) scale(0.4); pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.2s ease;
    transition-delay: calc(var(--i, 0) * 0.035s); }
  .theme-switcher.open .dot:not(.active) { opacity: 1; pointer-events: auto;
    transform: translate(var(--tx, 0), var(--ty, 0)) scale(var(--s, 1)); }
  .dot:hover { --s: 1.25; transition-delay: 0s; }
  .dot.active { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .dot, .palette-btn { transition: none; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-theme-switcher]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-palette-toggle]')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
    const RADIUS = 74;

    // 현재 테마를 제외한 점들을 버튼 주위(위→왼쪽) 부채꼴로 배치
    const layout = () => {
      const cur = document.documentElement.dataset.theme ?? 'light';
      const visible = dots.filter((d) => {
        const active = d.dataset.themeChoice === cur;
        d.classList.toggle('active', active);
        return !active;
      });
      const start = 90, spread = 110; // 90°(위) → 200°(왼쪽 약간 아래)
      visible.forEach((d, i) => {
        const a = ((start + (spread / (visible.length - 1)) * i) * Math.PI) / 180;
        d.style.setProperty('--tx', `${Math.cos(a) * RADIUS}px`);
        d.style.setProperty('--ty', `${-Math.sin(a) * RADIUS}px`);
        d.style.setProperty('--i', `${i}`);
      });
    };

    const setOpen = (open: boolean) => {
      root.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      dots.forEach((d) => (d.tabIndex = open && !d.classList.contains('active') ? 0 : -1));
    };
    toggle.addEventListener('click', () => {
      const willOpen = !root.classList.contains('open');
      if (willOpen) layout();
      setOpen(willOpen);
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    dots.forEach((b) => b.addEventListener('click', () => {
      const name = b.dataset.themeChoice!;
      if (name === 'light') {
        delete document.documentElement.dataset.theme;
        localStorage.removeItem('theme');
      } else {
        document.documentElement.dataset.theme = name;
        localStorage.setItem('theme', name);
      }
      setOpen(false);
      layout();
    }));
    layout();
  }
</script>
